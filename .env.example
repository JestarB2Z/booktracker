DATABASE_URL=file:/data/booktracker.db
SESSION_SECRET=change-me-to-a-random-32-plus-char-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login

# Only set this to "true" if HTTPS is genuinely terminated in front of this
# app with a real hostname (e.g. a Cloudflare Tunnel). Leave unset/false for
# plain HTTP access (LAN, or a raw VPN tunnel like Netbird) — a Secure
# cookie is silently dropped by browsers over HTTP, which breaks login.
COOKIE_SECURE=false
